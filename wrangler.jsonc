{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nasreddin",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-02",
  "routes": [
    {
      "pattern": "stories.asfar.family",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/audio/*",
      "!/social/*"
    ]
  }
}

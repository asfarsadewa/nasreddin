{
  "name": "wisdom-short-stories",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --port 4175",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1",
    "test:watch": "node --test --watch --test-concurrency=1",
    "test:e2e": "npm run build && playwright test",
    "check": "npm test && npm run build",
    "audio:music": "npm run audio:music:smell-of-soup",
    "audio:music:smell-of-soup": "node scripts/stories/smell-of-soup/generate-music.mjs",
    "audio:music:yan-er-dao-ling": "node scripts/stories/yan-er-dao-ling/generate-music.mjs",
    "audio:sfx:yan-er-dao-ling": "node scripts/stories/yan-er-dao-ling/generate-sfx.mjs",
    "audio:music:tiger-and-dried-persimmon": "node scripts/stories/tiger-and-dried-persimmon/generate-music.mjs",
    "audio:sfx:tiger-and-dried-persimmon": "node scripts/stories/tiger-and-dried-persimmon/generate-sfx.mjs",
    "audio:music:anansi-and-the-pot": "node scripts/stories/anansi-and-the-pot/generate-music.mjs",
    "audio:sfx:anansi-and-the-pot": "node scripts/stories/anansi-and-the-pot/generate-sfx.mjs",
    "audio:music:si-kancil-dan-buaya": "node scripts/stories/si-kancil-dan-buaya/generate-music.mjs",
    "audio:sfx:si-kancil-dan-buaya": "node scripts/stories/si-kancil-dan-buaya/generate-sfx.mjs",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^7.1.2",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "8.10.0"
  }
}
